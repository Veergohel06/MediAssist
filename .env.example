# MediAssist – Environment Configuration Example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit your actual API key, secret keys, or database credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Secret Key for Flask session signing and CSRF protection (required in production)
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=AQ.Ab8RN6LyH5OS8-f-m55AMwztsAkiFUBF4gkHejl3mXasCUd16A

# Database URL configuration (SQLAlchemy):
#   SQLite local: sqlite:///instance/mediassist.db (default if unset in development)
#   Neon PostgreSQL (Pooled - for application web traffic):
#     DATABASE_URL=postgresql://user:password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require
#   Neon PostgreSQL (Direct/Unpooled - for migrations / schema updates):
#     DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///instance/mediassist.db

# Flask environment & cookie security:
FLASK_ENV=development
SESSION_COOKIE_SECURE=false
WTF_CSRF_ENABLED=true

# Google Gemini API key (required for AI chat & embeddings)
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6LyH5OS8-f-m55AMwztsAkiFUBF4gkHejl3mXasCUd16A

# Generation model choice:
#   gemini-2.5-flash        ← baseline (highest precision & clinical contract adherence)
#   gemini-3.5-flash-lite   ← optimized alternative (50% token cost reduction, 3.6x faster latency)
GEMINI_MODEL=gemini-2.5-flash

# Embedding model (default: gemini-embedding-001)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# RAG Context & Retrieval Configuration
RAG_TOP_K=5                     # Final context passages provided to generation model
RAG_CANDIDATE_K=12              # Vector search candidate pool size
RAG_RETRIEVAL_MODE=semantic     # semantic | hybrid | keyword
RAG_CACHE_ENABLED=true          # Safe query and retrieval caching (true | false)
RAG_RERANK_ENABLED=false        # Cross-encoder / token-overlap reranker (true | false)

# Redis Rate Limiting (Required for multi-worker production deployments)
# If REDIS_URL is unset, falls back to in-memory rate limiting (single process).
# REDIS_URL=redis://localhost:6379/0
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS-API=A6c6h00e5sod2zp555ymb5st9rv8yttruqngpwqi99ovtme2vxp
# REDIS-URL=redis-cli --tls -u redis://default:gQAAAAAAA6F_AAIgcDE2NzY2MDI1NmRiMmE0NWM3YWE2ZDk5NmY0YmMxY2UyMw@becoming-parrot-237951.upstash.io:6379

# ─────────────────────────────────────────────────────────────────────────────
# Rollback Instructions:
# To rollback from optimized_v1 to baseline:
#   GEMINI_MODEL=gemini-2.5-flash
#   RAG_CACHE_ENABLED=false
#   RAG_TOP_K=5
#   RAG_CANDIDATE_K=12
#   RAG_RETRIEVAL_MODE=semantic
# ─────────────────────────────────────────────────────────────────────────────
